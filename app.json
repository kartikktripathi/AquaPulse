{
  "expo": {
    "name": "AquaPulse",
    "slug": "AquaPulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aquapulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AquaPulse needs your location to show where you are on the map."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AquaPulse needs your location to show where you are on the map."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
