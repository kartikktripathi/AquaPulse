{
  "expo": {
    "name": "AquaPulse",
    "slug": "AquaPulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aquapulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
